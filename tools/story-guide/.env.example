# Copy this file to tools/story-guide/.env and fill it in. .env is git-ignored.
# Get a key at https://aistudio.google.com/apikey. It stays on this computer.
GEMINI_API_KEY=
# A Gemma 4 model on the Gemini API: gemma-4-31b-it or gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it
# Optional: the port for the local page (default 5180)
# STORY_GUIDE_PORT=5180
